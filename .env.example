# Generate two distinct secrets, each at least 16 characters. Do not commit .env.
DOCUREVIEW_API_KEY=
DOCUREVIEW_REVIEWER_KEY=
DOCUREVIEW_REVIEWER_NAME=local-reviewer
DOCUREVIEW_PROVIDER=demo
DOCUREVIEW_DATABASE=data/docureview.sqlite3
# Locked off until a live-model evaluation supports a future policy change.
DOCUREVIEW_AUTO_ACCEPT=false
DOCUREVIEW_REVIEW_THRESHOLD=0.90
OLLAMA_URL=http://127.0.0.1:11434
# Required only when DOCUREVIEW_PROVIDER=ollama. Use a locally installed model tag.
OLLAMA_MODEL=

DOCUREVIEW_OCR_ENABLED=false
DOCUREVIEW_RETENTION_DAYS=7
# For named tenant identities, set this and UNSET both legacy key variables.
# DOCUREVIEW_IDENTITIES_FILE=/run/secrets/identities.json
# Require a recent worker heartbeat for readiness; disable synchronous processing.
DOCUREVIEW_REQUIRE_WORKER=false
DOCUREVIEW_SYNC_UPLOAD_ENABLED=true
DOCUREVIEW_MAX_PENDING_JOBS=100
DOCUREVIEW_PARSE_TIMEOUT_SECONDS=60
